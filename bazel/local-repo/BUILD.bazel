# `local-repo.localRepoJar` in build.mill / project/settings/package.mill:
# a JAR with a `local-repo.zip` resource (an Ivy repository with the runner,
# test-runner and java-test-runner at the Scala CLI version), extracted at run
# time by scala.build.LocalRepo so that a dev build never needs published stubs.
#
# Dependency lists mirror the ivy.xml files Mill generates
# (runner(Scala.runnerScala3), test-runner(Scala.runnerScala3), java-test-runner).

load("@rules_java//java:java_import.bzl", "java_import")

SCALA3_LIBRARY_LEGACY_LTS = "org.scala-lang:scala3-library_3:3.3.9"

MODULES = [
    (
        "runner_3",
        "//modules/runner:runner_legacy_lts",
        [SCALA3_LIBRARY_LEGACY_LTS],
    ),
    (
        "test-runner_3",
        "//modules/test-runner:test-runner_legacy_lts",
        [
            "org.ow2.asm:asm:9.11.1",
            "org.scala-lang.modules:scala-collection-compat_3:2.14.0",
            "org.scala-sbt:test-interface:1.0",
            SCALA3_LIBRARY_LEGACY_LTS,
            "com.github.sbt.junit:jupiter-interface:0.19.0:provided",
        ],
    ),
    (
        "java-test-runner",
        "//modules/java-test-runner",
        [
            "org.ow2.asm:asm:9.11.1",
            "org.scala-sbt:test-interface:1.0",
            "com.github.sbt.junit:jupiter-interface:0.19.0:provided",
        ],
    ),
]

genrule(
    name = "local_repo_jar",
    srcs = [target for _, target, _ in MODULES],
    outs = ["local-repo.jar"],
    cmd = "$(execpath //bazel/tools:local_repo_zip) $@ bazel-out/stable-status.txt " + " ".join([
        "--module org.virtuslab.scala-cli %s $$(echo $(execpaths %s) | tr ' ' '\\n' | grep -v -- '-ijar.jar$$' | grep '\\.jar$$' | head -1) '%s'" % (name, target, ",".join(deps))
        for name, target, deps in MODULES
    ]),
    stamp = 1,
    tools = ["//bazel/tools:local_repo_zip"],
)

java_import(
    name = "local-repo",
    jars = [":local_repo_jar"],
    visibility = ["//visibility:public"],
)
