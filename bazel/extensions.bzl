"""`build_info` module extension: build information for the generated Constants.scala files.

MODULE.bazel can't share values with .bzl files directly. This extension publishes, as
`@scala_cli_build_info//:info.bzl`:

* `BUILD_INFO`: the versions MODULE.bazel defines once and uses itself (Scala, GraalVM,
  coursier CLI, libsodium, ...), passed with `build_info.values(values = {...})`, and
  the contents of files passed with `files = {...}` (e.g. `.mill-version`);
* `MAVEN_VERSIONS`: `"group:artifact" -> version` for every artifact of the Maven lock
  file, so that dependency versions come from the resolution, not from copies.
"""

def _info_repo_impl(rctx):
    rctx.file("BUILD.bazel", 'exports_files(["info.bzl"])\n')
    rctx.file("info.bzl", "\n".join([
        '"""Generated by //bazel:extensions.bzl (build_info)."""',
        "",
        "BUILD_INFO = " + json.encode_indent(rctx.attr.values),
        "",
        "MAVEN_VERSIONS = " + json.encode_indent(rctx.attr.maven_versions),
        "",
    ]))

_info_repo = repository_rule(
    implementation = _info_repo_impl,
    attrs = {
        "maven_versions": attr.string_dict(),
        "values": attr.string_dict(),
    },
)

def _build_info_impl(mctx):
    values = {}
    maven_versions = {}
    for mod in mctx.modules:
        for tag in mod.tags.values:
            values.update(tag.values)
            for name, file in tag.files.items():
                values[name] = mctx.read(file).strip()
            if tag.maven_lock:
                lock = json.decode(mctx.read(tag.maven_lock))
                for coordinates, artifact in lock.get("artifacts", {}).items():
                    # keys are "group:artifact" (or "group:artifact:jar:classifier")
                    if len(coordinates.split(":")) == 2:
                        maven_versions[coordinates] = artifact["version"]
    _info_repo(name = "scala_cli_build_info", values = values, maven_versions = maven_versions)
    return mctx.extension_metadata(reproducible = True)

build_info = module_extension(
    implementation = _build_info_impl,
    tag_classes = {
        "values": tag_class(attrs = {
            "files": attr.string_keyed_label_dict(doc = "name -> file whose (trimmed) contents is the value"),
            "maven_lock": attr.label(doc = "rules_jvm_external lock file (maven_install.json)"),
            "values": attr.string_dict(),
        }),
    },
)
