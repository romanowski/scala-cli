load("@rules_java//toolchains:default_java_toolchain.bzl", "DEFAULT_JAVACOPTS", "DEFAULT_TOOLCHAIN_CONFIGURATION", "default_java_toolchain")
load("@rules_scala//scala:scala_cross_version.bzl", "version_suffix")
load("@rules_scala//scala:scala_toolchain.bzl", "scala_toolchain")
load("@rules_scala_config//:config.bzl", "SCALA_VERSIONS")
load("@rules_scala//testing:testing.bzl", "setup_scala_testing_toolchain")

exports_files(glob(["constants/*.scala.tpl"]))

# One toolchain per configured Scala version (see scala_config in MODULE.bazel).
#
# - dependency_mode = "transitive": the compile class path contains all
#   transitive dependencies, like Mill (rules_scala defaults to direct deps only).
# - `-java-output-version:17` mirrors javaOutputVersionOptions in
#   project/settings/package.mill (not applied to the legacy 3.3 LTS, whose
#   modules set their own options).
[
    scala_toolchain(
        name = "scala_toolchain_impl" + version_suffix(v),
        dependency_mode = "transitive",
        scalacopts = [] if v.startswith("3.3.") else ["-java-output-version:17"],
        strict_deps_mode = "off",
        unused_dependency_checker_mode = "off",
        use_argument_file_in_runner = True,
        visibility = ["//visibility:public"],
    )
    for v in SCALA_VERSIONS
]

[
    toolchain(
        name = "scala_toolchain" + version_suffix(v),
        target_settings = ["@rules_scala_config//:scala_version" + version_suffix(v)],
        toolchain = ":scala_toolchain_impl" + version_suffix(v),
        toolchain_type = "@rules_scala//scala:toolchain_type",
        visibility = ["//visibility:public"],
    )
    for v in SCALA_VERSIONS
]

# JUnit used to run the munit suites: the 4.13.2 that munit depends on
# (rules_scala's default 4.12 lacks APIs MUnitRunner calls).

setup_scala_testing_toolchain(
    name = "junit_toolchain",
    junit_classpath = [
        "@maven//:junit_junit",
        "@maven//:org_hamcrest_hamcrest_core",
    ],
)

# Java toolchain for language version 17 (.bazelrc): rules_java's default, minus `-g` and
# `-parameters`, so that javac output matches Mill's (plain javac: `-g:source,lines`, no
# MethodParameters attributes).
default_java_toolchain(
    name = "java_toolchain",
    configuration = DEFAULT_TOOLCHAIN_CONFIGURATION,
    misc = [o for o in DEFAULT_JAVACOPTS if o not in ("-g", "-parameters")],
    source_version = "17",
    target_version = "17",
)
