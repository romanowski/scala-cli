"""Bazel build for Scala CLI.

This runs alongside Mill during the migration (see bazel/README.md).
Versions below mirror project/deps/package.mill; keep them in sync
(bazel/check-mill-parity.sh verifies the generated constants).
"""

module(name = "scala_cli")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_scala", version = "7.4.1")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")

# --- Scala toolchain ---------------------------------------------------------
# Scala.scala3Next / Scala.defaultInternal in project/deps/package.mill.
# Override for a whole build with --repo_env=SCALA_VERSION=<one of scala_versions>,
# the Bazel counterpart of `./mill --define scala.version.internal=...`.
SCALA_VERSION = "3.10.0"

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(
    scala_version = SCALA_VERSION,
    scala_versions = [
        "3.3.9",  # Scala.scala3LegacyLts / runnerScala3
        "3.9.0",  # Scala.scala3Lts
    ],
)
use_repo(scala_config, "rules_scala_config")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
# JUnit comes from our own testing toolchain (//bazel:junit_toolchain), registered with //bazel:all.

# Our own toolchain: transitive compile classpath (like Mill) instead of
# rules_scala's default direct-only classpath. Defined in //bazel:BUILD.bazel.
register_toolchains("//bazel:all")

# --- Maven dependencies (Deps / TestDeps in project/deps/package.mill) --------
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

maven.install(
    name = "maven",
    artifacts = [
        # Java libraries
        "ch.epfl.scala:bsp4j:2.1.1",
        "ch.epfl.scala:scalafix-interfaces:0.14.9",
        "com.google.guava:guava:33.7.2-jre",
        "com.google.jimfs:jimfs:1.3.2",
        "com.swoval:file-tree-views:2.1.12",
        "io.get-coursier.jniutils:windows-jni-utils:0.4.0",
        "io.github.alexarchambault.python:interface:0.1.0",
        "org.bouncycastle:bcpkix-jdk18on:1.86",
        "org.eclipse.jgit:org.eclipse.jgit:7.8.0.202609011348-r",
        "org.graalvm.nativeimage:svm:25.0.5.0.3",
        "org.jsoup:jsoup:1.23.2",
        "org.ow2.asm:asm:9.11.1",
        "org.scala-sbt:test-interface:1.0",
        "org.slf4j:slf4j-nop:2.0.20",
        "org.virtuslab.scala-cli:libsodiumjni:0.0.4",
        "org.virtuslab.scala-cli.zip-input-stream:zip-input-stream:0.1.3",
        "com.github.sbt.junit:jupiter-interface:0.19.0",
        "com.github.docker-java:docker-java-transport-zerodep:3.7.1",
        # Scala 3 libraries (`::` in Mill)
        "ai.kien:python-native-libs_3:0.2.5",
        "ch.epfl.scala:bloop-rifle_3:2.1.3",
        "com.eed3si9n.expecty:expecty_3:0.17.1",
        "com.github.alexarchambault:case-app_3:2.1.1",
        "com.github.plokhotnyuk.jsoniter-scala:jsoniter-scala-core_3:2.42.2",
        "com.github.plokhotnyuk.jsoniter-scala:jsoniter-scala-macros_3:2.42.2",
        "com.lihaoyi:fansi_3:0.5.1",
        "com.lihaoyi:os-lib_3:0.11.10",
        "com.lihaoyi:pprint_3:0.9.6",
        "com.lihaoyi:ujson_3:4.4.3",
        "com.softwaremill.sttp.client3:core_3:3.11.0",
        "io.get-coursier:coursier_3:2.1.26",
        "io.get-coursier:coursier-launcher_3:2.1.26",
        "io.get-coursier:dependency_3:0.3.3",
        "org.scala-js:scalajs-env-nodejs_3:1.6.0",
        "org.scala-js:scalajs-logging_3:1.2.0",
        "org.scala-lang:scala3-directives-parser_3:" + SCALA_VERSION,
        "org.scala-lang.modules:scala-collection-compat_3:2.14.0",
        "org.scala-native:test-runner_3:0.5.12",
        "org.scala-native:tools_3:0.5.12",
        "org.scalameta:munit_3:1.3.6",
        "org.scalameta:munit-diff_3:1.3.6",
        "org.virtuslab:sloth-core_3:0.1.0-M2",
        "org.virtuslab.scala-cli:scala3-graal_3:1.9.1",
        "org.virtuslab.scala-cli:scala3-graal-processor_3:1.9.1",
        # Scala 2.13 libraries used from Scala 3 (explicit suffix in Mill too)
        "com.github.alexarchambault:argonaut-shapeless_6.3_2.13:1.3.1",
    ],
    excluded_artifacts = [
        # Provided by the rules_scala toolchain (Scala 3.10 standard library).
        "org.scala-lang:scala-library",
        "org.scala-lang:scala3-library_3",
        # Our own `config` module is used instead (Mill excludes it everywhere it can leak in).
        "org.virtuslab.scala-cli:config_3",
        "org.virtuslab.scala-cli:config_2.13",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    fetch_sources = True,
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
        # deps.customRepositories
        "https://oss.sonatype.org/content/repositories/snapshots",
        "https://s01.oss.sonatype.org/content/repositories/snapshots",
        "https://central.sonatype.com/repository/maven-snapshots",
    ],
)

# Bazel resolves one graph for the whole repository, whereas Mill resolves each module
# separately: without this, docker-java-core (integration tests only) would bump the
# commons-lang3 shipped in the CLI to 3.19.0. Keep the version `cli[].runClasspath` uses.
maven.artifact(
    artifact = "commons-lang3",
    force_version = True,
    group = "org.apache.commons",
    version = "3.18.0",
)

# Artifacts with per-dependency exclusions (`.exclude(...)` in Mill).
maven.artifact(
    artifact = "bloop-config_2.13",
    exclusions = ["com.github.plokhotnyuk.jsoniter-scala:jsoniter-scala-core_2.13"],
    group = "ch.epfl.scala",
    version = "2.3.3",
)

maven.artifact(
    artifact = "coursier-jvm_3",
    exclusions = ["com.google.collections:google-collections"],
    group = "io.get-coursier",
    version = "2.1.26",
)

maven.artifact(
    artifact = "coursier-archive-cache_3",
    exclusions = ["com.github.plokhotnyuk.jsoniter-scala:*"],
    group = "io.get-coursier",
    version = "2.1.26",
)

maven.artifact(
    artifact = "docker-java-core",
    exclusions = ["org.bouncycastle:bcpkix-jdk18on"],
    group = "com.github.docker-java",
    version = "3.7.1",
)

maven.artifact(
    artifact = "java-class-name_3",
    exclusions = [
        "org.jline:jline-reader",
        "org.jline:jline-terminal",
        "org.jline:jline-terminal-jna",
    ],
    group = "org.virtuslab.scala-cli.java-class-name",
    version = "0.2.0",
)

maven.artifact(
    artifact = "metaconfig-typesafe-config_3",
    exclusions = ["org.scala-lang:scala-compiler"],
    group = "org.scalameta",
    version = "0.18.8",
)

maven.artifact(
    artifact = "scala-packager_3",
    exclusions = ["com.lihaoyi:os-lib_2.13"],
    group = "org.virtuslab",
    version = "0.3.2",
)

maven.artifact(
    artifact = "scala-publish_3",
    group = "org.scala-lang",
    version = "1.0.0",
)

maven.artifact(
    artifact = "scalajs-env-jsdom-nodejs_2.13",
    exclusions = [
        "org.scala-js:scalajs-env-nodejs_2.13",
        "org.scala-js:scalajs-js-envs_2.13",
    ],
    group = "org.scala-js",
    version = "1.1.1",
)

maven.artifact(
    artifact = "scalajs-sbt-test-adapter_2.13",
    exclusions = ["org.scala-js:scalajs-js-envs_2.13"],
    group = "org.scala-js",
    version = "1.22.0",  # Scala.scalaJs
)

maven.artifact(
    artifact = "semanticdb-shared_2.13",
    exclusions = [
        "org.jline:jline",
        "com.lihaoyi:sourcecode_2.13",
        "org.scala-lang.modules:scala-collection-compat_2.13",
    ],
    group = "org.scalameta",
    version = "4.17.4",
)

SIGNING_EXCLUSIONS = [
    "com.github.alexarchambault:case-app_3",
    "com.github.plokhotnyuk.jsoniter-scala:jsoniter-scala-core_3",
    "com.github.plokhotnyuk.jsoniter-scala:jsoniter-scala-macros_3",
    "com.lihaoyi:os-lib_3",
    "com.lihaoyi:os-lib_2.13",
]

maven.artifact(
    artifact = "shared_3",
    exclusions = SIGNING_EXCLUSIONS,
    group = "org.virtuslab.scala-cli-signing",
    version = "0.5.0",
)

maven.artifact(
    artifact = "cli_3",
    exclusions = SIGNING_EXCLUSIONS,
    group = "org.virtuslab.scala-cli-signing",
    version = "0.5.0",
)

# Compile-only dependencies (`compileMvnDeps` in Mill).
[
    maven.amend_artifact(
        coordinates = c,
        neverlink = "true",
    )
    for c in [
        "com.github.plokhotnyuk.jsoniter-scala:jsoniter-scala-macros_3",
        "com.github.sbt.junit:jupiter-interface",
        "org.graalvm.nativeimage:svm",
    ]
]

use_repo(maven, "maven")

# --- Downloaded tools --------------------------------------------------------
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Files fetched at build time by `cli[].defaultFilesResources` in build.mill
# (Mill tracks `main`; pinned here for hermeticity).
DEFAULT_WORKFLOW_COMMIT = "1bc8a76272c71ee1211a79cb8f73230c087a04c5"

http_file(
    name = "default_workflow_ci_yml",
    downloaded_file_path = "default.yml",
    sha256 = "ef336f1c68ebe8a8917d557260c463554bf4a4a6dd8d41e78165eb0aae6cf94a",
    urls = ["https://raw.githubusercontent.com/scala-cli/default-workflow/" + DEFAULT_WORKFLOW_COMMIT + "/.github/workflows/ci.yml"],
)

http_file(
    name = "default_workflow_gitignore",
    downloaded_file_path = "default.gitignore",
    sha256 = "72da7b218c4369db31e6073a2ac0517623ba803a324950274401e3dcca8f8317",
    urls = ["https://raw.githubusercontent.com/scala-cli/default-workflow/" + DEFAULT_WORKFLOW_COMMIT + "/.gitignore"],
)

# Coursier CLI used by unit and integration tests (`settings.cs` in
# project/settings/package.mill, version Deps.Versions.coursierCli).
CS_VERSION = "2.1.26"

[
    http_file(
        name = "cs_" + platform.replace("-", "_"),
        sha256 = sha256,
        urls = ["https://github.com/coursier/coursier/releases/download/v%s/cs-%s.gz" % (CS_VERSION, platform)],
    )
    for platform, sha256 in {
        "aarch64-apple-darwin": "8e4d36aa2565276f262af073f0999399e4c2f920f2fe436bb0ae67665eb505e9",
        "aarch64-pc-linux": "6c358ac223332c8981eb86417d3faf9338a5ef6c95d1879a58162b24c510025c",
        "x86_64-apple-darwin": "c8045f36fadec075c8647b979d1028435935b0ecd43efa1387cd286c3926a421",
        "x86_64-pc-linux": "348e37bc2a8c706640e6b032c4551a0e055a7f1537485b4a91540e9d3598ec6d",
    }.items()
]

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cs_x86_64_pc_win32",
    build_file_content = 'exports_files(glob(["*.exe"]))',
    sha256 = "d23f4ba6afa7f092135b485303b0a020358fbb314abf9c6dc2576df3e2abd941",
    urls = ["https://github.com/coursier/coursier/releases/download/v%s/cs-x86_64-pc-win32.zip" % CS_VERSION],
)

# GraalVM CE used to build native images (deps.graalVmJvmId in project/deps/package.mill:
# graalvm-community:25.0.2, or 25.0.1 on macOS x64, which has no newer build).
GRAALVM_BUILD_FILE = """
exports_files([
    "bin/java",
    "bin/java.exe",
    "bin/native-image",
    "bin/native-image.cmd",
    "lib/security/cacerts",
])

filegroup(
    name = "files",
    srcs = glob(["**"], exclude = ["**/* *"]),
    visibility = ["//visibility:public"],
)
"""

[
    http_archive(
        name = "graalvm_" + platform.replace("-", "_"),
        build_file_content = GRAALVM_BUILD_FILE,
        sha256 = sha256,
        strip_prefix = "graalvm-community-openjdk-%s+%s%s" % (version, build, "/Contents/Home" if platform.startswith("macos") else ""),
        urls = ["https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-%s/graalvm-community-jdk-%s_%s_bin.%s" % (version, version, platform, "zip" if platform.startswith("windows") else "tar.gz")],
    )
    for platform, (version, build, sha256) in {
        "linux-aarch64": ("25.0.2", "10.1", "b4580d9f223d0a4b3a1757e58b18ff4c1db950e67e105fc5cb741457d2384a71"),
        "linux-x64": ("25.0.2", "10.1", "e0be791c8fda4d03b6b0a0cb824fef3149736170057b3a515252b44419606af0"),
        "macos-aarch64": ("25.0.2", "10.1", "50201fb8e8e653e7a253d955877a6b6ad634b42e60c84f45df7e1bb51361635f"),
        "macos-x64": ("25.0.1", "8.1", "a3d895b4cd1c783badbd277ec70409806bd4102fca0d2a60dbaeb0bab41aec30"),
        "windows-x64": ("25.0.2", "10.1", "72edc27ce2dd3c156332144a339c97995745cae291205ed2f9b5cc26aa9cb422"),
    }.items()
]

